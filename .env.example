# ============================================================
# NanoBot Environment Variables
# ============================================================

# Authoritative Application URL (Development vs Production)
# For local development: http://localhost:3000
# For production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Python Deep-Learning ML Service
ML_SERVICE_URL=http://127.0.0.1:8000

# Optional Neural Synthesis Gateways
OPENROUTER_API_KEY=your-openrouter-key
GROQ_API_KEY=your-groq-key

# Google OAuth Credentials (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: https://<your-project-ref>.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Node Environment
NODE_ENV=development

# ============================================================
# Integrations & OAuth (optional — enable only what you configure)
# ============================================================
# Credential encryption key (REQUIRED to connect any OAuth account).
# Any long random string; used to AES-256-GCM encrypt stored tokens.
CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# Google OAuth (Gmail / Calendar / Drive). Register this redirect URI in
# Google Cloud Console -> Credentials -> OAuth 2.0 Client:
#   <NEXT_PUBLIC_APP_URL>/api/connected-accounts/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn OAuth. Register the same redirect URI in the LinkedIn Developer portal:
#   <NEXT_PUBLIC_APP_URL>/api/connected-accounts/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Transactional email for the workflow Email node (optional)
RESEND_API_KEY=
EMAIL_FROM=NanoBot <onboarding@resend.dev>

# Shared secret protecting POST /api/automations/tick (optional)
CRON_SECRET=
